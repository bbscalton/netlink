#!/bin/sh /etc/rc.common
# Netlink multi-WAN downloader (procd)
START=95
USE_PROCD=1

add_wan() {
	local cfg="$1" dev src streams enabled
	config_get_bool enabled "$cfg" enabled 1
	[ "$enabled" = 1 ] || return
	config_get dev "$cfg" device
	config_get src "$cfg" source
	config_get streams "$cfg" streams 4
	[ -n "$dev" ] || return
	IFACES="${IFACES:+$IFACES,}$cfg=$dev${src:+@$src}:$streams"
}

start_service() {
	config_load netlink
	local enabled listen dir
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return
	config_get listen main listen '0.0.0.0:8099'
	config_get dir main dir '/tmp/netlink'
	IFACES=""
	config_foreach add_wan wan
	mkdir -p "$dir"
	procd_open_instance
	procd_set_param command /usr/bin/netlink -listen "$listen" -dir "$dir" -i "$IFACES"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() { procd_add_reload_trigger netlink; }
