config netlink 'main'
	option enabled '1'
	# Web UI address. Keep it on the LAN; do not expose to WAN.
	option listen '0.0.0.0:8099'
	# Where downloads go: /tmp/netlink is RAM (tmpfs). Use a USB mount for big files.
	option dir '/tmp/netlink'

# One section per WAN line. device = the Linux device of that line (see: ifstatus wan | grep l3_device)
config wan 'wan1'
	option device 'eth1'
	option streams '4'

config wan 'wan2'
	option device 'usb0'
	option streams '4'
	option enabled '1'
